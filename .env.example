# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# SUPABASE_URL: Your Supabase Project URL (e.g. https://your-project.supabase.co)
SUPABASE_URL=

# SUPABASE_SERVICE_ROLE_KEY: Supabase Service Role Secret Key (Server-side only)
SUPABASE_SERVICE_ROLE_KEY=

# VITE_SUPABASE_URL: Public Supabase project URL for browser client
VITE_SUPABASE_URL=

# VITE_SUPABASE_ANON_KEY: Public Supabase Anon/Public Key for browser client
VITE_SUPABASE_ANON_KEY=
