<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTP to HTTPS and non-WWW in one single hop
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\.dailybreadshawarma\.store$ [NC]
  RewriteRule ^(.*)$ https://dailybreadshawarma.store/$1 [R=301,L]

  # Force trailing slash on directories / non-files
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !(.*)/$
  RewriteRule ^(.*)$ https://dailybreadshawarma.store/$1/ [R=301,L]
</IfModule>
